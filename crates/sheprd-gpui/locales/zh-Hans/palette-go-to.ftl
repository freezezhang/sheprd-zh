# The command palette's Go To rows: what kind of place each row is, an
# agent's status, the agent filter, and the preview of the selected row.
# Workspace, tab, pane, and agent names are data.

# The badge at the end of a row, naming what the row goes to.
palette-go-to-workspace = 工作区
palette-go-to-tab = 标签页
palette-go-to-terminal = 终端
palette-go-to-note = 备注
# An agent's status, as its row's badge and the preview show it.
palette-go-to-blocked = 受阻
palette-go-to-done = 已完成
palette-go-to-working = 工作中
palette-go-to-idle = 空闲
# Searched for, never shown: what every agent row is.
palette-go-to-agent = 智能体
# The agent filter's choices (Alt with a letter picks one).
palette-go-to-filter-all = 所有智能体
palette-go-to-filter-blocked = 受阻
palette-go-to-filter-working = 工作中
palette-go-to-filter-idle = 空闲
palette-go-to-filter-done = 已完成
# The preview's facts about a row whose screen is not on hand.
palette-go-to-fact-status = 状态
palette-go-to-fact-directory = 目录
palette-go-to-fact-workspace = 工作区
palette-go-to-fact-tab = 标签页
palette-go-to-fact-branch = 分支
palette-go-to-fact-path = 路径
palette-go-to-fact-tabs = 标签页
# Over a pane's last frame; $age is how long ago, such as "3 min ago".
palette-go-to-last-seen = 上次出现于{ $age }
palette-go-to-connection-changed = 所选连接已发生变化。请重新打开命令面板。
