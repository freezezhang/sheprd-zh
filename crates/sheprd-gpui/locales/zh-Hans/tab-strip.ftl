# The strip of tabs over each group of panes, and what a group shows in
# place of a tab it cannot show. Tab names are the user's or the daemon's.

tab-strip-tabs = 标签页
tab-strip-new-tab = 新标签页
tab-strip-split = 拆分
tab-strip-actions = 标签页操作
# A chat launcher's tooltip; $agent is the agent's name, such as Claude.
tab-strip-new-chat = 新建 { $agent } 聊天
# On a tab dragged outside the window.
tab-strip-release-new-window = 松开以在新窗口中打开
# A tab another group shows, while it moves here.
tab-strip-opening = 正在打开…
tab-strip-show-here = 在此显示
# A split group with no tabs. Keep "+" and "⋯": they are the strip's
# buttons.
tab-strip-no-tabs = 没有标签页
tab-strip-no-tabs-hint = 使用“+”打开终端标签页，或从“⋯”菜单打开其他类型的标签页。
tab-strip-nothing = 没有可显示的内容。
# A muted tab's name for screen readers.
tab-strip-muted = { $label }，通知已静音
