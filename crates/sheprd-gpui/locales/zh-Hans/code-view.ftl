# Code tabs: a source file shown read-only, with its definitions listed as
# an outline. File text and definition names are never translated.

# The outline's heading; $count is how many definitions it lists.
code-view-outline-count = 大纲 · { $count }
code-view-outline = 大纲
code-view-hide-outline = 隐藏大纲
code-view-open-in-editor = 在编辑器中打开
code-view-reading = 正在读取文件…
code-view-no-workspace = 请先打开工作区
code-view-too-many-tabs = 打开的标签页过多
# What each definition in the outline is.
code-view-kind-function = 函数
code-view-kind-method = 方法
code-view-kind-type = 类型
code-view-kind-module = 模块
code-view-kind-constant = 常量
code-view-kind-implementation = impl
code-view-kind-macro = 宏
