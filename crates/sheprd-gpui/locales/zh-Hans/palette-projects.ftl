# The command palette's project rows: local checkouts under the configured
# project roots, and the row that makes a new one. Paths and URLs are data.

# A local project's detail, before its path.
palette-projects-local = 本地  { $path }
# $name is what was typed, $path where it goes, $url the repository cloned.
palette-projects-create-folder = 创建文件夹“{ $name }”
palette-projects-new-in = 在 { $path } 中新建项目
palette-projects-clone = 克隆“{ $name }”
palette-projects-clone-into = 将 git clone { $url } 克隆到 { $path }
