# The status bar along the window's foot.

status-bar-label = 状态栏
# The connection to the Herdr daemon, shown while it is not simply
# connected. "Herdr server" is the daemon.
status-bar-connecting = 正在连接...
status-bar-starting-daemon = 正在启动 Herdr 服务器...
status-bar-awaiting-snapshot = 已连接；正在等待快照
status-bar-connected = 已连接
status-bar-disconnected = 已断开连接
status-bar-detached = 已分离（守护进程仍在运行）
# $status is one of the above, $error what went wrong.
status-bar-status-error = { $status }：{ $error }
# Pane resize mode, which has no control on screen; keep the key names.
status-bar-resize = 调整大小
status-bar-resize-keys = 使用 h j k l 或方向键调整大小，按 Esc 结束
status-bar-theme = 主题
status-bar-shortcuts = 快捷键
status-bar-report-issue = 报告问题
status-bar-update-available = 有可用更新
# A screen reader's name for the version button; $version is the app's.
status-bar-version = 版本 { $version }
# The focused agent's model; $model is the agent's own name for it.
status-bar-model = 模型 { $model }
status-bar-change-model = 更换模型
# The keep-awake cup: its name, and its tooltip while on and off. A
# right-click holds it until every agent finishes its work.
status-bar-awake-display = 保持显示器唤醒
status-bar-awake-system = 保持系统唤醒
status-bar-awake-until-agents = 直到智能体完成
status-bar-awake-display-until-agents = 保持显示器唤醒，直到智能体完成
status-bar-awake-system-until-agents = 保持系统唤醒，直到智能体完成
status-bar-awake-display-on = 正在保持显示器唤醒 · 右键：直到智能体完成
status-bar-awake-system-on = 正在保持系统唤醒 · 右键：直到智能体完成
status-bar-awake-display-off = 保持显示器唤醒 · 右键：直到智能体完成
status-bar-awake-system-off = 保持系统唤醒 · 右键：直到智能体完成
