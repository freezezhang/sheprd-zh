# Labels above a tool's retained source or reported edits in rich conversations.
rich-tools-terminal = 终端
rich-tools-source = 源码
rich-tools-command = 命令
rich-tools-arguments = 参数
rich-tools-output = 输出
rich-tools-reported-patch = 报告的补丁 · 提供的差异块
rich-tools-no-changes = 提供的文本中没有更改。
# $kind is what the call does, such as Run; $label is the agent's title for it.
rich-tools-details = { $kind }：{ $label }

# $path is the filename reported by the agent. The preview compares only the
# supplied text; it does not read files or reconstruct a missing previous file.
rich-tools-provided-text = { $path } · 提供的文本
rich-tools-diff-preview-limit = { $path } · 提供的文本超出差异预览限制
rich-tools-written-content = { $path } · 写入的内容；原内容不可用
