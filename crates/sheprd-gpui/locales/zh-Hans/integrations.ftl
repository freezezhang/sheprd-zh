# The agent integrations a daemon's host reports and installs, as Settings >
# Integrations lists them.

integrations-no-host = 未选择主机
integrations-host = 守护进程主机：{ $host }
integrations-explainer = 安装操作会更新此守护进程所在主机上的智能体配置，该主机不一定是此电脑。不会自动安装任何集成。
integrations-working = 正在所选守护进程上执行...
integrations-refresh = 刷新集成
integrations-none = 此守护进程未报告任何集成。
integrations-no-match = 没有匹配的集成。
integrations-not-installed = 未安装
integrations-current = 最新
integrations-outdated = 已过时
# $status is one of the three states above; $command is the agent's command.
integrations-row-detail = { $status } | { $command }
integrations-unavailable = 此主机上没有该智能体
integrations-install = 安装
integrations-reinstall = 重新安装
integrations-install-unsupported = 此守护进程不支持安装
integrations-host-changed = 所选守护进程已更改或断开。请刷新以加载集成。已排队的安装可能已在先前的主机上完成。
integrations-list-changed = 主机或集成列表已更改。请在安装前刷新。
