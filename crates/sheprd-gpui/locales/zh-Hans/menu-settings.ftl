# The Keyboard Shortcuts page, and the in-app menu's config reloads.

menu-settings-load-failed = 加载 GUI 配置：{ $error }
menu-settings-title = 键盘快捷键
menu-settings-subtitle = 查看和编辑快捷键
menu-settings-close = 关闭
menu-settings-search = 搜索快捷键…
menu-settings-count = { $count } / { $total } 个快捷键
menu-settings-footer = 按 Esc 关闭 / 点击外部收起
# Section headings over the list of shortcuts.
menu-settings-workspaces = 工作区与窗格
menu-settings-navigation = 导航
menu-settings-application = 应用
menu-settings-commands = 插件与自定义命令
# The row for pasting into the terminal, which no command holds.
menu-settings-paste = 粘贴到终端
menu-settings-no-shortcut = 未分配快捷键
menu-settings-edit = 编辑
menu-settings-no-match = 没有匹配的快捷键。请尝试操作名称或组合键。
# "[keys]" is a section of Herdr's config file; keep it as it is.
menu-settings-note = 包含 Herdr 的 [keys] 前缀组合键，以及已连接守护进程的插件和自定义命令。无法执行的绑定会显示原因。终端应用保留各自的快捷键。
# Why a plugin or custom command's binding does not run, under its keys.
menu-settings-shadowed = 已被 Herdr 或 GUI 快捷键使用
menu-settings-taken = 已被前面的命令使用
menu-settings-needs-modifier = 需要修饰键
menu-settings-no-prefix = 没有可用的前缀键
menu-settings-over-limit = 超出了 { $limit } 个快捷键的限制
menu-settings-unsupported = 此客户端不支持
