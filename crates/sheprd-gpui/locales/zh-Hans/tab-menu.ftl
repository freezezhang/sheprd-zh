# A Herdr tab's menu, from a right-click on the tab, and its rename and move
# pages.

tab-menu-new-tab = 新标签页
tab-menu-rename = 重命名
# Opens the list of workspaces the tab can move to.
tab-menu-move-to-workspace = 移至工作区…
# Stops the tab's terminal agent and continues its conversation in a chat, in
# the same pane. Same words as the palette's commands-convert-to-chat.
tab-menu-move-to-chat = 将智能体移入聊天
# Silences the tab's notifications, or lets them through again.
tab-menu-mute = 静音通知
tab-menu-unmute = 取消通知静音
# The tab's whole workspace is muted; the row unmutes the workspace.
tab-menu-unmute-workspace = 取消工作区静音
# The tab's whole device is muted; the row unmutes the device.
tab-menu-unmute-device = 取消设备静音
tab-menu-close = 关闭标签页

tab-menu-rename-placeholder = 标签页名称
tab-menu-rename-title = 重命名标签页
tab-menu-cancel = 取消
tab-menu-renaming = 正在重命名…
tab-menu-rename-submit = 重命名

tab-menu-moving = 正在移动标签页…
tab-menu-move-heading = 移至工作区
