# Notes on a browser tab's page for the agent that opened it: the panel
# beside the page and the messages around sending them.

browser-notes-title = 备注
# The text field a note is written in.
browser-notes-describe = 描述要更改的内容…
# The button that makes a drag draw a region over the page.
browser-notes-region = 区域
# A note on the whole page rather than on a part of it.
browser-notes-page = 页面备注
browser-notes-empty = 点击页面元素、选择文本或按住 Shift 拖出区域，然后描述要更改的内容。
browser-notes-capturing = 正在截图…
browser-notes-add = 添加备注
browser-notes-save = 保存备注
# Shown in place of a note's text when the page sent a result without one.
browser-notes-placeholder = 添加备注…
# A note already sent to the agent. $note is what it points at on the page.
browser-notes-sent = { $note } · 已发送
browser-notes-withdraw = 撤回
browser-notes-copy = 复制
browser-notes-clear-sent = 清除已发送的备注

# What a note points at. $width and $height are in pixels.
browser-notes-region-size = 区域 { $width }×{ $height }
browser-notes-whole-page = 整个页面
# Something the page itself sent for the agent. $summary is the page's own
# one-line summary of it.
browser-notes-page-result = 页面结果
browser-notes-page-result-summary = 页面结果：{ $summary }

browser-notes-no-page = 没有可标注的页面
browser-notes-armed = 点击元素或选择文本以添加备注
browser-notes-full = 请先清除已发送的备注或移除部分备注，再继续添加
browser-notes-result = 页面已添加结果；请发送给智能体
browser-notes-empty-note = 请先填写要更改的内容
browser-notes-screenshots-failed = 无法保存截图
browser-notes-copied = 已复制备注
browser-notes-pending = 先前的备注仍在等待发送
browser-notes-delivered = 智能体已收到这些备注
browser-notes-withdrawn = 已撤回备注
