# Browser tabs: web pages and files an agent wrote, shown beside a
# workspace's terminals.

browser-unsupported = 浏览器标签页需要 macOS 或 Windows
browser-no-pages = 此构建无法显示页面
browser-open-workspace-first = 请先打开工作区
browser-too-many-tabs = 打开的浏览器标签页过多

# The address field above a page.
browser-address-placeholder = 输入地址
browser-address-invalid = 不是 http 或 https 地址

# The button that starts or stops taking notes on the page for an agent.
browser-annotate = 标注

# What a tab shows where its page is not there yet. $error is why the
# system could not create the page, in its own words.
browser-page-failed = 无法显示此页面：{ $error }
browser-page-empty = 在上方输入地址并按 Return。
browser-page-unsupported = 此构建无法在窗口中显示页面；请在系统浏览器中打开。
browser-page-loading = 正在加载…

# Tab titles. A new tab has no address yet.
browser-tab-new = 新标签页
# A review of a checkout's changes. $branch is its branch.
browser-tab-review = 审查 · { $branch }
# An orchestrator tab. $repo is a repository's name.
browser-tab-orchestrator = 编排器 · { $repo }
browser-tab-devices = 设备
browser-tab-terminal = 终端
