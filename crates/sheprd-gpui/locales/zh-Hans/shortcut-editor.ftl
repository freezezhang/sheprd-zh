# Editing a command's shortcuts from the Keyboard Shortcuts page.

shortcut-editor-save-failed = 保存键盘快捷键：{ $error }
shortcut-editor-save = 保存
shortcut-editor-unbind = 取消绑定
shortcut-editor-reset = 重置
# $command is the command's name, such as Split Right.
shortcut-editor-title = 编辑 { $command }
# Key names stay as typed in the config file: ctrl, shift, alt, cmd.
shortcut-editor-hint = 输入带修饰键的按键名称，如 ctrl-shift-t；也可使用 prefix- 加上前缀键之后的按键，如 prefix-x。多个备选快捷键用空格分隔。
shortcut-editor-note = 保存将替换此命令的快捷键，包括守护进程的组合键。重置将恢复继承的默认值。
# The empty field's placeholder. $example is a shortcut as the config file
# writes it, such as ctrl-shift-t.
shortcut-editor-placeholder = 例如 { $example }
shortcut-editor-cancel = 取消
shortcut-editor-saving = 正在保存…
