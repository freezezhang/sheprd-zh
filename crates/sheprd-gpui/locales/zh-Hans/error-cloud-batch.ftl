# Cloud machines an agent asked for from the command line.

# $provider is a cloud provider's name.
error-cloud-batch-not-offered = 无法从命令行创建 { $provider } 机器。
# $code is the setup script's exit code.
error-cloud-batch-setup-exited = 初始化脚本已退出，退出码为 { $code }。
# $output is what the setup script printed, kept as it is.
error-cloud-batch-setup-exited-output = 初始化脚本已退出，退出码为 { $code }：{ $output }
error-cloud-batch-setup-signal = 初始化脚本被信号终止。
error-cloud-batch-setup-signal-output = 初始化脚本被信号终止：{ $output }
