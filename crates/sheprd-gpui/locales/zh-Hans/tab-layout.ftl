# How tab strips draw their tabs (View > Tab Layout, Settings > Tabs & panes).

tab-layout-classic = 经典
tab-layout-pills = 胶囊
tab-layout-outline = 轮廓
tab-layout-underline = 下划线
tab-layout-cards = 卡片
tab-layout-curved = 曲线
tab-layout-compact = 紧凑

# The tooltip standing in for a tab's title when the tab face hides it;
# $label is the tab's name.
tab-layout-muted-hint = { $label }（通知已静音）
# The close button on a tab, for screen readers.
tab-layout-close = 关闭标签页
