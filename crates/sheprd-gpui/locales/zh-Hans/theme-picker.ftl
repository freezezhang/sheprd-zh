# The color scheme picker the menu opens. Theme names are data.

theme-picker-title = 配色方案
theme-picker-close = 关闭
theme-picker-search = 搜索主题…
# How many themes match the search, of all there are.
theme-picker-count = { $total ->
    [one] { $shown } / { $total } 个主题
   *[other] { $shown } / { $total } 个主题
}
theme-picker-empty = 没有匹配的主题。请缩短搜索内容后重试。
# Beside the theme the window shows now.
theme-picker-current = 当前
theme-picker-saving = 正在保存主题…请稍候。
theme-picker-loading = 正在加载主题…按 Esc 取消。
theme-picker-hint = 悬停或按上/下方向键预览。按 Enter 或点击主题可保存。为主题加星标可将其置顶。
theme-picker-star = 为主题加星标
theme-picker-unstar = 取消主题星标
theme-picker-favorites-failed = 无法保存收藏主题：{ $error }
